/target
target/
/data
garmr.toml
*.redb
.env

# Release build artifacts (regenerable; the 161MB binary must never enter history)
/dist/

# Generated AI context packs (nornir docs ai-context) — regenerate, do not version
/docs/ai-context.md
/docs/ai-context-full.md

# Editor lock/scratch artifacts (LibreOffice/OnlyOffice)
.~lock.*#
.claude/
.idea/

# Long-running agent harness runtime state (local-only; see .claude/CLAUDE.md)
/PROGRESS.md
/test-results.json
/NEXT_FINDINGS.md
/AGENT_STOP
/STEER.md
/evidence/

# Written into an exported public tree by scripts/public-export.sh (manifest,
# digests and source-commit provenance). Useful for verifying an export in
# place; never part of the tracked tree.
.export-manifest.txt
.export-digests.sha256
.export-provenance
